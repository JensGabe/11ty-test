RewriteEngine On

# Redirect www to non-www (and force HTTPS)
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

# Redirect HTTP to HTTPS (non-www)
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Old URLs from before the 2026 restructuring
RewriteRule ^regler/?$ /priser/ [L,R=301]
RewriteRule ^reservationer/?$ /book/#kalender [L,R=301,NE]
RewriteRule ^kontakt/?$ /book/#forespoergsel [L,R=301,NE]
RewriteRule ^lokalerne/?$ /huset/ [L,R=301]
RewriteRule ^plantegning/?$ /huset/#plantegning [L,R=301,NE]
RewriteRule ^inventar/?$ /praktisk/inventarliste/ [L,R=301]
RewriteRule ^huskeliste/?$ /praktisk/ [L,R=301]
RewriteRule ^bestyrelsen/?$ /foreningen/#bestyrelsen [L,R=301,NE]
RewriteRule ^grundejerforeninger/?$ /foreningen/#grundejerforeninger [L,R=301,NE]
RewriteRule ^vedt(æ|%C3%A6)gter/?$ /foreningen/vedtaegter/ [L,R=301]
